# Frontend (Next.js) environment. Copy to .env.local for development; in
# production set these in the Vercel project settings. Never commit real values.
# The frontend needs NO backend secrets (JWT_SECRET, MONGO_URI for the API,
# GEMINI_API_KEY, GOOGLE_CLIENT_SECRET): keep those only on the API host.

# Public (exposed to the browser) ------------------------------------------
# Not needed: the public website no longer calls the Express API (accounts
# and the portal are retired). Leave unset. Only for local portal work:
# Express API base URL including /api, e.g. http://localhost:5000/api
NEXT_PUBLIC_API_URL=
# Optional Cloudflare Turnstile site key. When set, the contact form shows the
# widget; set TURNSTILE_SECRET_KEY too so the server verifies it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: enquiry pipeline (/api/leads) --------------------------------
# Storage. Use a dedicated least-privilege Atlas user with readWrite on this
# database only (it does not need access to the portal's user data).
LEADS_MONGODB_URI=
LEADS_DB_NAME=veda_leads
# Random string (32+ characters). Used to hash IP addresses for abuse limits.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADS_IP_HASH_SALT=

# Notification email to the business inbox (plain text).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEADS_MAIL_FROM=
# Monitored inbox that receives every enquiry, e.g. enquiries@vedascholars.com
LEADS_NOTIFY_TO=

# Optional: Cloudflare Turnstile secret (required if the site key is set).
TURNSTILE_SECRET_KEY=
