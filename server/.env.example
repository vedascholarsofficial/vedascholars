# Copy to server/.env for local development. Never commit real values.
# In production, set these in the hosting provider's secret/environment settings.

NODE_ENV=development
PORT=5000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is missing, shorter than 32 characters or a placeholder.
JWT_SECRET=
# Optional. Default 7d.
JWT_EXPIRES_IN=7d

# Required. Use a least-privilege Atlas user scoped to this database only.
MONGO_URI=

# Required in production (https). Defaults to localhost in development.
# CLIENT_URL: the website origin used in password-reset and sign-in redirects.
# API_PUBLIC_URL: this API's public origin, used for the Google OAuth callback.
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# Comma-separated origins allowed to call the API from a browser.
# Defaults to CLIENT_URL. Example: https://www.vedascholars.com,https://vedascholars.com
CORS_ORIGINS=

# Number of reverse proxies in front of the API (load balancer, CDN).
# 0 when the API is exposed directly. Usually 1 on Render/Railway/Heroku-style hosts.
# Wrong values either break rate limiting or let clients spoof their IP.
TRUST_PROXY_HOPS=0

# Self-service sign-up (email registration and first-time Google sign-in).
# Leave unset: the public website has no sign-up, and privileged roles are
# only ever granted by an administrator. Existing accounts can still sign in.
PUBLIC_SIGNUP_ENABLED=

# Optional: OTP and password-reset emails (Gmail app password or switch transport).
EMAIL_USER=
EMAIL_PASS=

# Optional: Google sign-in. Leave both empty to disable it.
# Authorised redirect URI in Google Cloud Console: <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: VedaBot. Leave empty to disable (returns 503).
GEMINI_API_KEY=
